import java.util.Scanner;
class MaximumSumPair{
public static int maximumSumPair(int[]ar){
  int maximum = Integer.MIN_VALUE, secondMaximum = Integer.MIN_VALUE;
  for(int i=0;i<ar.length;i++){
    if(ar[i] > maximum){
      secondMaximum = maximum;
      maximum = ar[i];
    }
    else if(ar[i] > secondMaximum){
      secondMaximum = ar[i];
    }
  }
  return maximum + secondMaximum;
}
  public static void main(String[]args){
  Scanner scan = new Scanner(System.in);
  int n = scan.nextInt();
  int[] ar = new int[n];
  for(int i=0;i<ar.length;i++){
    ar[i] = scan.nextInt();
    }
    int res = maximumSumPair(ar);
    System.out.print(res);
  }
}
